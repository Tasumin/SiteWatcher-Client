SITEWATCH_SERVER_URL=https://monitoring.talondns.com
SITEWATCH_AGENT_TOKEN=YOUR_GENERATED_AGENT_TOKEN

# Preferred: multiple discovery ranges separated by commas, spaces, semicolons, or newlines.
SITEWATCH_DISCOVERY_CIDRS=192.168.1.0/24,192.168.4.0/24,10.20.0.0/24

# Backward-compatible single range. Used only when SITEWATCH_DISCOVERY_CIDRS is blank.
SITEWATCH_DISCOVERY_CIDR=

SITEWATCH_DISCOVERY_INTERVAL_SECONDS=900
SITEWATCH_SNAPSHOT_INTERVAL_SECONDS=300
