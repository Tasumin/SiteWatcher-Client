SITEWATCH_SERVER_URL=https://nodevyu.com
SITEWATCH_AGENT_TOKEN=YOUR_GENERATED_AGENT_TOKEN

# Preferred: multiple discovery ranges separated by commas, spaces, semicolons, or newlines.
SITEWATCH_DISCOVERY_CIDRS=192.168.1.0/24,192.168.4.0/24,10.20.0.0/24

# Backward-compatible single range. Used only when SITEWATCH_DISCOVERY_CIDRS is blank.
SITEWATCH_DISCOVERY_CIDR=

SITEWATCH_DISCOVERY_INTERVAL_SECONDS=900
SITEWATCH_SNAPSHOT_INTERVAL_SECONDS=300

# Limit scheduled RTSP health probes only. Live View probes bypass this pool.
SITEWATCH_MAX_RTSP_PROBES=2

# Live camera streaming. H.264 sources are remuxed; other codecs fall back to H.264 transcode.
SITEWATCH_MAX_LIVE_STREAMS=2
SITEWATCH_MAX_LIVE_TRANSCODES=1
SITEWATCH_LIVE_MAX_BITRATE_KBPS=2500
SITEWATCH_LIVE_MAX_WIDTH=1280
SITEWATCH_LIVE_TRANSCODE_THREADS=2
SITEWATCH_LIVE_STARTUP_TIMEOUT_SECONDS=15

# Beta features. Disabled by default. A server/admin setting, when present, overrides this local value.
SITEWATCH_BETA_AI_DETECTION=false
